# ---------------------------------------------------------------------------
# frontend/.env  —  everything here is PUBLIC.
# Vite bakes these values into the JavaScript bundle you publish, so only ever
# put public data here. A private key would be readable by anyone.
# ---------------------------------------------------------------------------

# VITE_CHAIN_ID and VITE_RPC_URL must point at the SAME network — change them
# together, never one without the other:
#   31337 + http://127.0.0.1:8545   (local Hardhat node — the default below)
#   84532 + https://sepolia.base.org (Base Sepolia)
#   8453  + https://mainnet.base.org (Base mainnet)
VITE_CHAIN_ID=31337

# Printed by contracts/scripts/deploy.js
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Used for the read-only view, so guests with no wallet still see the page.
VITE_RPC_URL=http://127.0.0.1:8545

# "/" for a custom domain, "/<repo-name>/" for a GitHub Pages project site.
VITE_BASE_PATH=/
