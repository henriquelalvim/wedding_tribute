{
  "name": "wedding-gift-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WeddingGift smart contract for the Base network",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
