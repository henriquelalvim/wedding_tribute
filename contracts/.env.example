# ---------------------------------------------------------------------------
# contracts/.env  —  NEVER commit the real file. It holds a private key.
# Copy to .env and fill in. `npx hardhat test` works without any of this.
# ---------------------------------------------------------------------------

# Deployer private key (0x-prefixed). Only needs enough ETH to pay for the deploy.
# This key NEVER goes anywhere near the frontend.
#
# This wallet is baked into the contract as `deployer` — typically YOUR wallet, not
# the couple's. It is the only address allowed to later assign the groom/bride (via
# setGroom/setBride) and to hide an abusive tribute.
PRIVATE_KEY=

# Optional. The couple's addresses aren't known at deploy time — they don't exist
# until the groom/bride log in for the first time. Fill these in later, after they
# have, then run `npm run set-couple -- --network <name>` — or skip this file
# entirely and use the frontend's admin panel instead, which does the same thing.
GROOM_ADDRESS=
BRIDE_ADDRESS=

# RPC endpoints (the public ones below are fine for a deploy this small).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# For `npx hardhat verify` — get one at https://basescan.org/myapikey
BASESCAN_API_KEY=
