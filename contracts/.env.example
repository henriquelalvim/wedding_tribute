# ---------------------------------------------------------------------------
# contracts/.env  —  NEVER commit the real file. It holds a private key.
# Copy to .env and fill in. `npx hardhat test` works without any of this.
# ---------------------------------------------------------------------------

# Deployer private key (0x-prefixed). Only needs enough ETH to pay for the deploy.
# This key NEVER goes anywhere near the frontend.
#
# This wallet is baked into the contract as `deployer` — typically YOUR wallet, not
# the couple's. It is the one address besides the groom and the bride allowed to set
# the gift dedication, which matches the common case: you deploy and fund the gift,
# they show up later to propose and accept. Keep it different from GROOM_ADDRESS and
# BRIDE_ADDRESS below; deploy.js warns if it isn't.
PRIVATE_KEY=

# The couple. Baked into the contract at deploy time and immutable afterwards.
GROOM_ADDRESS=
BRIDE_ADDRESS=

# RPC endpoints (the public ones below are fine for a deploy this small).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# For `npx hardhat verify` — get one at https://basescan.org/myapikey
BASESCAN_API_KEY=
