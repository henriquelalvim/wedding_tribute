# ---------------------------------------------------------------------------
# contracts/.env  —  NEVER commit the real file. It holds a private key.
# Copy to .env and fill in. `npx hardhat test` works without any of this.
# ---------------------------------------------------------------------------

# Deployer private key (0x-prefixed). Only needs enough ETH to pay for the deploy.
# This key NEVER goes anywhere near the frontend.
PRIVATE_KEY=

# The couple. Baked into the contract at deploy time and immutable afterwards.
GROOM_ADDRESS=
BRIDE_ADDRESS=

# RPC endpoints (the public ones below are fine for a deploy this small).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# For `npx hardhat verify` — get one at https://basescan.org/myapikey
BASESCAN_API_KEY=
